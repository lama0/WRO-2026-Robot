from hub import port
import motor
import distance_sensor
import runloop
import math

# -----------------------------
# PORTS
# -----------------------------

STEER = port.A
DISTANCE = port.C
DRIVE = port.E

# Port B = Color Sensor
# Color obstacle logic will be added after physical testing.

# -----------------------------
# BASIC SETTINGS
# -----------------------------

DRIVE_DIRECTION = 1
EXIT_DIRECTION = 1

STRAIGHT = -2

WHEEL_DIAMETER_CM = 5.6
DEG_PER_CM = 360 / (math.pi * WHEEL_DIAMETER_CM)

# -----------------------------
# PARKING EXIT
# -----------------------------

PARK_STEERING_SPEED = 230
PARK_SLOW_SPEED = 200
PARK_FAST_SPEED = 240

# -----------------------------
# RIGHT CORNER SETTINGS
# -----------------------------

CORNER_STEP = 55
LAST_CORNER_STEP = 80

CORNER_STEP_DISTANCE_CM = 8

CORNER_SPEED = 400
STEERING_SPEED = 400
RECENTER_SPEED = 600
SEARCH_WALL_SPEED = 340

WALL_FOUND_DISTANCE = 360
FOUND_COUNT_NEEDED = 2

current_steer = 0


# -----------------------------
# STEERING FUNCTIONS
# -----------------------------

async def steer_relative(angle, speed=STEERING_SPEED):
    global current_steer

    await motor.run_for_degrees(
        STEER,
        angle,
        speed,
        stop=motor.HOLD
    )

    current_steer += angle


async def set_steering(target, speed=STEERING_SPEED):
    global current_steer

    difference = target - current_steer

    if difference != 0:
        await motor.run_for_degrees(
            STEER,
            difference,
            speed,
            stop=motor.HOLD
        )

    current_steer = target


async def set_straight():
    await set_steering(
        STRAIGHT,
        RECENTER_SPEED
    )


# -----------------------------
# DRIVE FUNCTION
# -----------------------------

async def drive_cm(distance_cm, speed):
    degrees = int(distance_cm * DEG_PER_CM)

    await motor.run_for_degrees(
        DRIVE,
        degrees * DRIVE_DIRECTION,
        speed
    )


# -----------------------------
# PARKING EXIT
# -----------------------------

async def exit_parking():

    # First steering movement
    await steer_relative(
        55 * EXIT_DIRECTION,
        PARK_STEERING_SPEED
    )

    await motor.run_for_degrees(
        DRIVE,
        140 * DRIVE_DIRECTION,
        PARK_SLOW_SPEED
    )

    # Second steering movement
    await steer_relative(
        55 * EXIT_DIRECTION,
        PARK_STEERING_SPEED
    )

    await motor.run_for_degrees(
        DRIVE,
        380 * DRIVE_DIRECTION,
        PARK_FAST_SPEED
    )

    # Return steering
    await steer_relative(
        -55 * EXIT_DIRECTION,
        PARK_STEERING_SPEED
    )

    await motor.run_for_degrees(
        DRIVE,
        140 * DRIVE_DIRECTION,
        PARK_SLOW_SPEED
    )

    await steer_relative(
        -55 * EXIT_DIRECTION,
        PARK_STEERING_SPEED
    )

    motor.stop(DRIVE)


# -----------------------------
# RIGHT CORNER
# -----------------------------

async def turn_right_until_wall():

    # Step 1
    await steer_relative(
        CORNER_STEP,
        STEERING_SPEED
    )

    await drive_cm(
        CORNER_STEP_DISTANCE_CM,
        CORNER_SPEED
    )

    # Step 2
    await steer_relative(
        CORNER_STEP,
        STEERING_SPEED
    )

    await drive_cm(
        CORNER_STEP_DISTANCE_CM,
        CORNER_SPEED
    )

    # Step 3
    await steer_relative(
        CORNER_STEP,
        STEERING_SPEED
    )

    await drive_cm(
        CORNER_STEP_DISTANCE_CM,
        CORNER_SPEED
    )

    # Step 4
    await steer_relative(
        LAST_CORNER_STEP,
        STEERING_SPEED
    )

    await drive_cm(
        CORNER_STEP_DISTANCE_CM,
        CORNER_SPEED
    )

    # Keep turning right until the new wall is detected
    motor.run(
        DRIVE,
        SEARCH_WALL_SPEED * DRIVE_DIRECTION
    )

    found_count = 0

    while True:

        distance = distance_sensor.distance(DISTANCE)

        if (
            distance != -1
            and distance <= WALL_FOUND_DISTANCE
        ):
            found_count += 1
        else:
            found_count = 0

        if found_count >= FOUND_COUNT_NEEDED:
            break

        await runloop.sleep_ms(20)

    # Stop before recentering
    motor.stop(DRIVE)

    # Recenter while robot is stationary
    await set_straight()


# -----------------------------
# MAIN PROGRAM
# -----------------------------

async def main():
    global current_steer

    # IMPORTANT:
    # Physically place the front wheels straight before starting.
    motor.reset_relative_position(STEER, 0)
    current_steer = 0

    # Straight calibration
    await set_straight()

    # Exit starting parking position
    await exit_parking()

    # Make sure steering is straight
    await set_straight()

    # Drive straight 13 cm before starting corner
    await drive_cm(13, 350)

    # Execute tested right corner
    await turn_right_until_wall()

    motor.stop(DRIVE)


runloop.run(main())
